<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Twinfold">
    <suite name="Twinfold Suite" code="FErs" description="Zugriff auf Auswahl und Ordner (z. B. für Hookmark).">
        <class name="application" code="capp" description="Twinfold">
            <cocoa class="NSApplication"/>
            <property name="name" code="pnam" type="text" access="r" description="Name der App.">
                <cocoa key="name"/>
            </property>
            <property name="selected paths" code="FEsp" access="r" description="POSIX-Pfade der ausgewählten Objekte im aktiven Fenster.">
                <type type="text" list="yes"/>
                <cocoa key="selectedPaths"/>
            </property>
            <property name="current folder" code="FEcf" type="text" access="r" description="POSIX-Pfad des Ordners im aktiven Fenster.">
                <cocoa key="currentFolderPath"/>
            </property>
            <property name="debug info" code="FEdb" type="text" access="r" description="Diagnose-Informationen.">
                <cocoa key="scriptingDebugInfo"/>
            </property>
        </class>
    </suite>
</dictionary>
